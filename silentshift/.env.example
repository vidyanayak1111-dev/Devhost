# Copy this file to ".env" (same folder as run.py) and paste your Groq key.
# Free key: https://console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY=

# ---------------- Optional (leave empty = automatic) ----------------
# Which model bot-latest normally runs on. Auto = your Ollama Qwen model.
# SS_PRODUCTION=ollama:qwen2.5:3b
# Where the "model_swap" change silently moves it. Auto = Groq GPT-OSS-20b.
# SS_MODEL_NEW=groq:openai/gpt-oss-20b
# A q8 build of the same Qwen enables the "serving_quant" change. Auto-detected if installed:
#   ollama pull qwen2.5:3b-instruct-q8_0
# SS_OLLAMA_Q8=qwen2.5:3b-instruct-q8_0
# Groq free tier is ~30 requests/min - SilentShift paces itself below that:
# SS_GROQ_RPM=25

# ---------------- Ollama server (local or remote) ----------------
# Ollama on another computer, shared with provider_tools/start_tunnel.bat (Cloudflare):
# SS_OLLAMA_URL=https://random-words.trycloudflare.com
# The model name your app asks for. On the Ollama server it's a real model made with `ollama create`:
# SS_OLLAMA_ALIAS=bot-latest
