# Copy this file to ".env" (same folder as run.py), fill it in, then run:  python run.py --api
# Works with ANY OpenAI-compatible API. Examples below - check your provider's model list,
# model names change often.

# ---- Groq (free API key at console.groq.com) ----
SS_API_BASE=https://api.groq.com/openai/v1
SS_API_KEY=paste-your-key-here
SS_API_MODEL=openai/gpt-oss-20b
SS_API_MODEL_NEW=openai/gpt-oss-120b
SS_API_EXTRA={"reasoning_effort": "low"}

# ---- OpenAI ----
# SS_API_BASE=https://api.openai.com/v1
# SS_API_MODEL=gpt-4o-mini
# SS_API_MODEL_NEW=gpt-4.1-mini

# ---- Google Gemini (OpenAI-compatible endpoint) ----
# SS_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# SS_API_MODEL=gemini-2.5-flash-lite
# SS_API_MODEL_NEW=gemini-2.5-flash

# ---- OpenRouter (one key, many model families) ----
# SS_API_BASE=https://openrouter.ai/api/v1
# SS_API_MODEL=meta-llama/llama-3.1-8b-instruct
# SS_API_MODEL_NEW=qwen/qwen-2.5-7b-instruct

# Optional: a second serving variant of the SAME model (enables the quant_q8 "serving" change)
# SS_API_MODEL_SERVING=

# Optional: speed tolerance (network APIs are noisy; default 0.35 = 35%)
# SS_SPEED_TOL=0.35
